# Publicas — vao para o browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secreta — SO no servidor. Usada apenas para administrar clientes OAuth.
# Nunca e usada para escrever nas tabelas: essas levam o JWT do utilizador.
SUPABASE_SECRET_KEY=sb_secret_...

# Identidade publica do servico. Nunca derivada do host do pedido.
NEXT_PUBLIC_BASE_URL=https://registry.powerfarm.app

# Origem do host Identity. Em desenvolvimento, execute-o na porta 3001.
NEXT_PUBLIC_IDENTITY_BASE_URL=http://localhost:3001
