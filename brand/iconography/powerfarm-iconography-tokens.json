{
  "brand": "POWERFARM",
  "system": "Iconography",
  "version": "0.5.1",
  "grid": {
    "viewBox": "0 0 64 64",
    "base_size": 64
  },
  "stroke": {
    "default": 4,
    "small_size": 3,
    "cap": "square",
    "join": "bevel"
  },
  "color": {
    "default": "#F8DFC1",
    "accent": "#FFB02E",
    "dark": "#080702",
    "recoloring": "icons use currentColor"
  },
  "principles": [
    "Geometric and technical rather than playful.",
    "Prefer square caps and bevel joins.",
    "Use consistent optical weight across the family.",
    "Avoid enclosed micro-details that disappear at small sizes.",
    "Use outline icons by default.",
    "Use a single color per icon in normal UI.",
    "Amber is for emphasis, active states, or key metrics.",
    "Do not place iconography inside the official logo shape."
  ],
